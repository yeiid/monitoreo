# ─────────────────────────────────────────────────
# Monitoreo FTTH — Variables de Entorno para Dokploy
# ─────────────────────────────────────────────────

# JWT - Seguridad (OBLIGATORIO - genera con: openssl rand -hex 32)
JWT_SECRET_KEY=GENERA_UNA_CLAVE_SEGURA_CON_openssl_rand_hex_32

# Base de Datos (PostGIS)
POSTGRES_USER=monitoreo
POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASEÑA
POSTGRES_DB=monitoreodb

# Super Admin (solo para seed inicial)
SUPER_ADMIN_EMAIL=admin@ftth-mapper.com
SUPER_ADMIN_PASSWORD=CAMBIA_ESTA_CONTRASEÑA
SUPER_ADMIN_NAME=Super Administrador

# CORS (dominio de producción)
CORS_ORIGINS=https://neuraljira.tech

# Frontend (variables de build — ya están configuradas en docker-compose.yml)
# PUBLIC_API_URL=/api/v1
# PUBLIC_MAP_TILE_URL=https://map.neuraljira.tech/api/v1/style.json

# Puertos expuestos en el host (para evitar conflictos de puertos en Dokploy)
DB_PORT=5435
WEB_PORT=8081

