---
import DashboardLayout from "../layouts/DashboardLayout.astro";
---

<DashboardLayout title="Cables & Rutas - FTTH Mapper">
    <div class="data-table-container animate-in">
        <div
            style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;"
        >
            <div>
                <h1
                    style="font-size: 1.8rem; font-weight: 800; margin-bottom: 4px;"
                >
                    Cables y Rutas de Fibra
                </h1>
                <p style="color: var(--text-muted); font-size: 0.9rem;">
                    Administra el tendido de cables, capacidades y la generación
                    de hilos según la norma TIA-598.
                </p>
            </div>
            <div style="display: flex; gap: 12px;">
                <a href="/" class="btn btn-glass" style="text-decoration: none;"
                    >← Volver al Mapa</a
                >
                <button class="btn btn-primary" id="btn-new-cable">+ Nuevo Cable</button>
            </div>
        </div>

        <div
            class="glass-panel"
            style="padding: 20px 24px; margin-bottom: 24px; background: rgba(139, 92, 246, 0.03);"
        >
            <h3
                style="margin-bottom: 16px; font-size: 0.85rem; color: var(--text-primary); text-transform: uppercase; letter-spacing: 0.05em;"
            >
                Código de Colores TIA-598
            </h3>
            <div
                class="color-grid"
                id="color-grid"
                style="display: flex; flex-wrap: wrap; gap: 8px;"
            >
            </div>
        </div>

        <div class="glass-panel" style="padding: 4px;">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Nombre del Cable</th>
                        <th>Tipo</th>
                        <th>Capacidad</th>
                        <th>Hilos</th>
                        <th>Descripción</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody id="routes-tbody">
                    <tr>
                        <td
                            colspan="6"
                            style="text-align:center; padding: 60px; color: var(--text-muted);"
                        >
                            <div class="animate-pulse">
                                Cargando rutas de fibra...
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Modal para Crear/Editar Cable -->
    <div id="cable-modal" class="modal-overlay" style="display: none;">
        <div class="modal-content glass-panel" style="max-width: 550px; padding: 30px; width: 95%;">
            <div class="modal-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
                <h3 id="cable-modal-title" style="margin: 0; font-size: 1.3rem; font-weight: 800; color: white;">Nuevo Cable</h3>
                <button class="modal-close-btn" id="btn-close-cable-modal" style="background: none; border: none; color: var(--text-muted); font-size: 1.5rem; cursor: pointer; padding: 4px;">×</button>
            </div>
            <form id="cable-form" style="display: flex; flex-direction: column; gap: 16px;">
                <input type="hidden" id="cable-id" />
                <div class="form-group" style="display: flex; flex-direction: column; gap: 6px;">
                    <label for="cable-name" style="font-size: 0.75rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;">Nombre del Cable</label>
                    <input type="text" id="cable-name" required placeholder="Ej: Cable Troncal Norte" style="background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 12px 16px; color: white; outline: none; font-size: 0.95rem;" />
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                    <div class="form-group" style="display: flex; flex-direction: column; gap: 6px;">
                        <label for="cable-type" style="font-size: 0.75rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;">Tipo de Cable</label>
                        <select id="cable-type" required style="background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 12px 16px; color: white; outline: none; font-size: 0.95rem; cursor: pointer;">
                            <option value="TRONCAL">Troncal</option>
                            <option value="DISTRIBUCION">Distribución</option>
                            <option value="ACOMETIDA">Acometida</option>
                        </select>
                    </div>
                    <div class="form-group" style="display: flex; flex-direction: column; gap: 6px;">
                        <label for="cable-capacity" style="font-size: 0.75rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;">Capacidad (Hilos)</label>
                        <select id="cable-capacity" required style="background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 12px 16px; color: white; outline: none; font-size: 0.95rem; cursor: pointer;">
                            <option value="6">6 Hilos</option>
                            <option value="12" selected>12 Hilos</option>
                            <option value="24">24 Hilos</option>
                            <option value="48">48 Hilos</option>
                            <option value="96">96 Hilos</option>
                            <option value="144">144 Hilos</option>
                        </select>
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                    <div class="form-group" style="display: flex; flex-direction: column; gap: 6px;">
                        <label for="cable-start-node" style="font-size: 0.75rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;">Nodo Inicio (Opcional)</label>
                        <select id="cable-start-node" style="background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 12px 16px; color: white; outline: none; font-size: 0.95rem; cursor: pointer;">
                            <option value="">Sin nodo inicial</option>
                        </select>
                    </div>
                    <div class="form-group" style="display: flex; flex-direction: column; gap: 6px;">
                        <label for="cable-end-node" style="font-size: 0.75rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;">Nodo Fin (Opcional)</label>
                        <select id="cable-end-node" style="background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 12px 16px; color: white; outline: none; font-size: 0.95rem; cursor: pointer;">
                            <option value="">Sin nodo final</option>
                        </select>
                    </div>
                </div>

                <div class="form-group" style="display: flex; flex-direction: column; gap: 6px;">
                    <label for="cable-desc" style="font-size: 0.75rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;">Descripción</label>
                    <textarea id="cable-desc" rows="3" placeholder="Notas sobre el tendido, longitud estimada, etc." style="background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 12px 16px; color: white; outline: none; font-size: 0.95rem; resize: none;"></textarea>
                </div>

                <div style="display: flex; gap: 12px; margin-top: 16px; justify-content: flex-end;">
                    <button type="button" class="btn btn-glass" id="btn-cancel-cable-modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar Cable</button>
                </div>
            </form>
        </div>
    </div>
</DashboardLayout>

<script>
    import { API_BASE } from "../components/map/types";
    import { apiFetch } from "../utils/apiFetch";
    import { TIA_COLORS } from "../constants/network";

    let cachedNodes: any[] = [];

    // TIA-598 Color Grid
    const colorGrid = document.getElementById("color-grid")!;
    if (colorGrid) {
        colorGrid.innerHTML = TIA_COLORS.map(
            (c, i) => `
            <div style="display: flex; align-items: center; gap: 8px; padding: 6px 10px; background: rgba(255,255,255,0.03); border-radius: 8px; border: 1px solid var(--border);">
                <div style="width: 12px; height: 12px; border-radius: 3px; background: ${c.hex}; ${c.name === "Blanco" ? "border: 1px solid #444" : ""}"></div>
                <span style="font-size: 0.72rem; font-weight: 700; color: var(--text-muted); min-width: 14px;">${i + 1}</span>
                <span style="font-size: 0.75rem; color: var(--text-secondary);">${c.name}</span>
            </div>
        `).join("");
    }

    // Modal Elements
    const modal = document.getElementById("cable-modal")!;
    const modalTitle = document.getElementById("cable-modal-title")!;
    const cableForm = document.getElementById("cable-form") as HTMLFormElement;
    const cableIdInput = document.getElementById("cable-id") as HTMLInputElement;
    const cableNameInput = document.getElementById("cable-name") as HTMLInputElement;
    const cableTypeSelect = document.getElementById("cable-type") as HTMLSelectElement;
    const cableCapacitySelect = document.getElementById("cable-capacity") as HTMLSelectElement;
    const cableStartNodeSelect = document.getElementById("cable-start-node") as HTMLSelectElement;
    const cableEndNodeSelect = document.getElementById("cable-end-node") as HTMLSelectElement;
    const cableDescInput = document.getElementById("cable-desc") as HTMLTextAreaElement;

    function openModal(id: string | null = null) {
        cableForm.reset();
        if (id) {
            modalTitle.textContent = "Editar Cable";
            // Edit mode would require caching routes; for now only create
        } else {
            modalTitle.textContent = "Nuevo Cable";
            cableIdInput.value = "";
        }
        modal.style.display = "flex";
    }

    function closeModal() {
        modal.style.display = "none";
    }

    // Load nodes for start/end dropdowns
    async function loadNodes() {
        try {
            const res = await apiFetch(`${API_BASE}/nodes`);
            if (!res.ok) throw new Error("API error");
            cachedNodes = await res.json();

            const nodeOptions = cachedNodes.map((n: any) =>
                `<option value="${n.id}">${n.name} (${n.node_type})</option>`
            ).join("");

            cableStartNodeSelect.innerHTML = `<option value="">Sin nodo inicial</option>${nodeOptions}`;
            cableEndNodeSelect.innerHTML = `<option value="">Sin nodo final</option>${nodeOptions}`;
        } catch (e) {
            console.error("Failed to load nodes", e);
        }
    }

    // Load routes
    async function loadRoutes() {
        try {
            const res = await apiFetch(`${API_BASE}/routes`);
            if (!res.ok) throw new Error("API error");
            const routes = await res.json();
            localStorage.setItem("ftth_routes", JSON.stringify(routes));
            renderRoutes(routes);
        } catch {
            const cached = localStorage.getItem("ftth_routes");
            if (cached) renderRoutes(JSON.parse(cached));
        }
    }

    (window as any).centerOnRoute = function(id: string) {
        const routes = JSON.parse(localStorage.getItem('ftth_routes') || '[]');
        const r = routes.find((route: any) => route.id === id);
        if (r) {
            localStorage.setItem('ftth_center_on_route', JSON.stringify(r));
            window.location.href = '/';
        }
    };

    function renderRoutes(routes: any[]) {
        const tbody = document.getElementById("routes-tbody")!;
        if (routes.length === 0) {
            tbody.innerHTML = '<tr><td colspan="6" class="empty-state">No hay rutas registradas</td></tr>';
            return;
        }

        const typeColors: Record<string, string> = {
            TRONCAL: '#A855F7',
            DISTRIBUCION: '#3B82F6',
            ACOMETIDA: '#10B981'
        };

        tbody.innerHTML = routes.map(r => `
            <tr class="animate-in glass-row">
                <td>
                    <div class="name-cell">
                        <span class="type-icon">🧵</span>
                        <div class="name-info">
                            <span class="node-name">${r.name}</span>
                            <span class="node-id">#${r.id.slice(0, 8)}</span>
                        </div>
                    </div>
                </td>
                <td><span class="modern-badge" style="background: ${typeColors[r.route_type]}1a; color: ${typeColors[r.route_type]}">${r.route_type}</span></td>
                <td><span class="modern-badge" style="background: rgba(255,255,255,0.05); color: var(--text-secondary);">${r.capacity} Hilos</span></td>
                <td>
                    <button class="action-btn-wide" onclick="generateStrands('${r.id}')">
                        Generar Hilos
                    </button>
                </td>
                <td class="desc-cell">${r.description || '—'}</td>
                <td>
                    <div class="action-group">
                        <button class="action-btn locate" onclick="centerOnRoute('${r.id}')">
                            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" fill="none" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                        </button>
                        <button class="action-btn delete" onclick="deleteRoute('${r.id}')">
                            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" fill="none" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                        </button>
                    </div>
                </td>
            </tr>
        `).join("");
    }

    (window as any).generateStrands = async function (routeId: string) {
        try {
            const res = await apiFetch(`${API_BASE}/strands/generate`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ route_id: routeId }),
            });
            if (res.ok) alert(`Hilos generados con éxito.`);
        } catch (e) {
            alert("Error generando hilos.");
        }
    };

    (window as any).deleteRoute = async function(id: string) {
        if (!confirm("¿Eliminar este cable?")) return;
        try {
            const res = await apiFetch(`${API_BASE}/routes/${id}`, { method: "DELETE" });
            if (res.ok) loadRoutes();
        } catch {}
    };

    // Form submit: Create route
    cableForm.addEventListener("submit", async (e) => {
        e.preventDefault();

        const payload: any = {
            name: cableNameInput.value,
            route_type: cableTypeSelect.value,
            capacity: parseInt(cableCapacitySelect.value, 10),
            description: cableDescInput.value || null,
            start_node_id: cableStartNodeSelect.value || null,
            end_node_id: cableEndNodeSelect.value || null,
        };

        try {
            const res = await apiFetch(`${API_BASE}/routes`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(payload),
            });
            if (res.ok) {
                closeModal();
                loadRoutes();
            } else {
                const errData = await res.json();
                alert(`Error: ${errData.detail || "No se pudo guardar el cable."}`);
            }
        } catch {
            alert("Error de conexión al guardar el cable.");
        }
    });

    // Event Listeners
    document.getElementById("btn-new-cable")!.addEventListener("click", () => openModal(null));
    document.getElementById("btn-close-cable-modal")!.addEventListener("click", closeModal);
    document.getElementById("btn-cancel-cable-modal")!.addEventListener("click", closeModal);
    modal.addEventListener("click", (e) => {
        if (e.target === modal) closeModal();
    });

    // Init
    async function init() {
        await loadNodes();
        await loadRoutes();
    }
    init();
</script>

