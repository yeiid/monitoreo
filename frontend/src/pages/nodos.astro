---
import DashboardLayout from "../layouts/DashboardLayout.astro";
---

<DashboardLayout title="Nodos de Red - FTTH Mapper">
    <div class="data-table-container animate-in">
        <div
            style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;"
        >
            <div>
                <h1
                    style="font-size: 1.8rem; font-weight: 800; margin-bottom: 4px;"
                >
                    Gestión de Nodos
                </h1>
                <p style="color: var(--text-muted); font-size: 0.9rem;">
                    Visualiza y administra todos los puntos físicos de tu
                    infraestructura.
                </p>
            </div>
            <div style="display: flex; gap: 12px;">
                <a href="/" class="btn btn-glass" style="text-decoration: none;"
                    >← Volver al Mapa</a
                >
                <button class="btn btn-primary" id="btn-new-node">+ Nuevo Nodo</button>
            </div>
        </div>

        <div class="stats-grid">
            <div class="stat-card glass-panel">
                <div
                    class="stat-icon"
                    style="background: rgba(244, 63, 94, 0.1); color: var(--olt-color);"
                >
                    📡
                </div>
                <div class="stat-info">
                    <span class="label">Total OLTs</span>
                    <span class="value" id="count-olt">-</span>
                </div>
            </div>
            <div class="stat-card glass-panel">
                <div
                    class="stat-icon"
                    style="background: rgba(251, 191, 36, 0.1); color: var(--mufla-color);"
                >
                    🔶
                </div>
                <div class="stat-info">
                    <span class="label">Muflas</span>
                    <span class="value" id="count-mufla">-</span>
                </div>
            </div>
            <div class="stat-card glass-panel">
                <div
                    class="stat-icon"
                    style="background: rgba(34, 211, 238, 0.1); color: var(--nap-color);"
                >
                    📦
                </div>
                <div class="stat-info">
                    <span class="label">Cajas NAP</span>
                    <span class="value" id="count-nap">-</span>
                </div>
            </div>
            <div class="stat-card glass-panel">
                <div
                    class="stat-icon"
                    style="background: rgba(52, 211, 153, 0.1); color: var(--client-color);"
                >
                    🏠
                </div>
                <div class="stat-info">
                    <span class="label">Clientes ONU</span>
                    <span class="value" id="count-client">-</span>
                </div>
            </div>
        </div>

        <div class="glass-panel" style="padding: 4px; overflow-x: auto;">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Tipo</th>
                        <th>Ubicación</th>
                        <th>Potencia (dBm)</th>
                        <th>Descripción</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody id="nodes-tbody">
                    <tr>
                        <td
                            colspan="6"
                            style="text-align:center; padding: 60px; color: var(--text-muted);"
                        >
                            <div class="animate-pulse">
                                Cargando nodos de red...
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Modal para Crear/Editar Nodo -->
    <div id="node-modal" class="modal-overlay" style="display: none;">
        <div class="modal-content glass-panel" style="max-width: 550px; padding: 30px; width: 95%;">
            <div class="modal-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
                <h3 id="modal-title" style="margin: 0; font-size: 1.3rem; font-weight: 800; color: white;">Nuevo Nodo</h3>
                <button class="modal-close-btn" id="btn-close-modal" style="background: none; border: none; color: var(--text-muted); font-size: 1.5rem; cursor: pointer; padding: 4px;">×</button>
            </div>
            <form id="node-form" style="display: flex; flex-direction: column; gap: 16px;">
                <input type="hidden" id="node-id" />
                <div class="form-group" style="display: flex; flex-direction: column; gap: 6px;">
                    <label for="node-name" style="font-size: 0.75rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;">Nombre del Nodo</label>
                    <input type="text" id="node-name" required placeholder="Ej: Mufla de Reparto B" style="background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 12px 16px; color: white; outline: none; font-size: 0.95rem;" />
                </div>
                
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                    <div class="form-group" style="display: flex; flex-direction: column; gap: 6px;">
                        <label for="node-type" style="font-size: 0.75rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;">Tipo de Nodo</label>
                        <select id="node-type" required style="background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 12px 16px; color: white; outline: none; font-size: 0.95rem; cursor: pointer;">
                            <option value="OLT">OLT (Central)</option>
                            <option value="MUFLA">Mufla (Fusión)</option>
                            <option value="CAJA_NAP">Caja NAP</option>
                            <option value="CLIENTE_ONU">Cliente ONU</option>
                            <option value="ODF">ODF (Distribuidor)</option>
                        </select>
                    </div>
                    <div class="form-group" style="display: flex; flex-direction: column; gap: 6px;">
                        <label for="node-power" style="font-size: 0.75rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;">Potencia Óptica (dBm)</label>
                        <input type="number" step="any" id="node-power" placeholder="Ej: -18.5" style="background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 12px 16px; color: white; outline: none; font-size: 0.95rem;" />
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                    <div class="form-group" style="display: flex; flex-direction: column; gap: 6px;">
                        <label for="node-lat" style="font-size: 0.75rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;">Latitud</label>
                        <input type="number" step="any" id="node-lat" required placeholder="Ej: 4.60971" style="background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 12px 16px; color: white; outline: none; font-size: 0.95rem;" />
                    </div>
                    <div class="form-group" style="display: flex; flex-direction: column; gap: 6px;">
                        <label for="node-lng" style="font-size: 0.75rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;">Longitud</label>
                        <input type="number" step="any" id="node-lng" required placeholder="Ej: -74.08175" style="background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 12px 16px; color: white; outline: none; font-size: 0.95rem;" />
                    </div>
                </div>

                <div class="form-group" style="display: flex; flex-direction: column; gap: 6px;">
                    <label for="node-desc" style="font-size: 0.75rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;">Descripción / Detalles</label>
                    <textarea id="node-desc" rows="3" placeholder="Ubicación física, hilos reservados, etc." style="background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 12px 16px; color: white; outline: none; font-size: 0.95rem; resize: none;"></textarea>
                </div>

                <div style="display: flex; gap: 12px; margin-top: 16px; justify-content: flex-end;">
                    <button type="button" class="btn btn-glass" id="btn-cancel-modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary" id="btn-save-node">Guardar Nodo</button>
                </div>
            </form>
        </div>
    </div>
</DashboardLayout>

<script>
    import { API_BASE } from "../components/map/types";
    import { apiFetch } from "../utils/apiFetch";

    let cachedNodes: any[] = [];

    const NODE_BADGES: Record<string, string> = {
        OLT: "olt",
        MUFLA: "mufla",
        CAJA_NAP: "nap",
        CLIENTE_ONU: "client",
        ODF: "olt", // Share olt style badge or customize
    };
    const NODE_LABELS: Record<string, string> = {
        OLT: "OLT",
        MUFLA: "Mufla",
        CAJA_NAP: "Caja NAP",
        CLIENTE_ONU: "Cliente ONU",
        ODF: "ODF (Distribuidor)",
    };

    const modal = document.getElementById("node-modal")!;
    const modalTitle = document.getElementById("modal-title")!;
    const nodeForm = document.getElementById("node-form") as HTMLFormElement;
    const nodeIdInput = document.getElementById("node-id") as HTMLInputElement;
    const nodeNameInput = document.getElementById("node-name") as HTMLInputElement;
    const nodeTypeSelect = document.getElementById("node-type") as HTMLSelectElement;
    const nodePowerInput = document.getElementById("node-power") as HTMLInputElement;
    const nodeLatInput = document.getElementById("node-lat") as HTMLInputElement;
    const nodeLngInput = document.getElementById("node-lng") as HTMLInputElement;
    const nodeDescInput = document.getElementById("node-desc") as HTMLTextAreaElement;

    async function loadNodes() {
        try {
            const res = await apiFetch(`${API_BASE}/nodes`);
            if (!res.ok) throw new Error("API error");
            cachedNodes = await res.json();
            localStorage.setItem("ftth_nodes", JSON.stringify(cachedNodes));
            renderNodes(cachedNodes);
        } catch (e) {
            const cached = localStorage.getItem("ftth_nodes");
            if (cached) renderNodes(JSON.parse(cached));
        }
    }

    (window as any).centerOnNode = function(id: string) {
        const n = cachedNodes.find((node: any) => node.id === id);
        if (n) {
            localStorage.setItem('ftth_center_on_node', JSON.stringify({
                id: n.id,
                lng: n.location.lng,
                lat: n.location.lat
            }));
            window.location.href = '/';
        }
    };

    function renderNodes(nodes: any[]) {
        const counts = { OLT: 0, MUFLA: 0, CAJA_NAP: 0, CLIENTE_ONU: 0, ODF: 0 };
        nodes.forEach(n => {
            if (n.node_type in counts) {
                counts[n.node_type as keyof typeof counts]++;
            }
        });
        
        document.getElementById("count-olt")!.textContent = String(counts.OLT + counts.ODF);
        document.getElementById("count-mufla")!.textContent = String(counts.MUFLA);
        document.getElementById("count-nap")!.textContent = String(counts.CAJA_NAP);
        document.getElementById("count-client")!.textContent = String(counts.CLIENTE_ONU);

        const tbody = document.getElementById("nodes-tbody")!;
        if (nodes.length === 0) {
            tbody.innerHTML = '<tr><td colspan="6" class="empty-state">No hay nodos registrados</td></tr>';
            return;
        }

        const nodeIcons: Record<string, string> = {
            OLT: '📡', MUFLA: '🔶', CAJA_NAP: '📦', CLIENTE_ONU: '🏠', ODF: '⚙️'
        };

        tbody.innerHTML = nodes.map(n => `
            <tr class="animate-in glass-row">
                <td>
                    <div class="name-cell">
                        <span class="type-icon">${nodeIcons[n.node_type] || '📍'}</span>
                        <div class="name-info">
                            <span class="node-name" style="color: white; font-weight: 600;">${n.name}</span>
                            <span class="node-id">#${n.id.slice(0, 8)}</span>
                        </div>
                    </div>
                </td>
                <td><span class="modern-badge badge-${NODE_BADGES[n.node_type] || 'nap'}">${NODE_LABELS[n.node_type] || n.node_type}</span></td>
                <td class="coords-cell">${parseFloat(n.location.lat).toFixed(5)}, ${parseFloat(n.location.lng).toFixed(5)}</td>
                <td><span class="power-val ${n.optical_power_dbm < -25 ? 'low' : 'good'}" style="font-weight: 700;">${n.optical_power_dbm ?? '—'} <small>dBm</small></span></td>
                <td class="desc-cell">${n.description || '—'}</td>
                <td>
                    <div class="action-group">
                        <button class="action-btn locate" onclick="centerOnNode('${n.id}')" title="Centrar en Mapa">
                            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" fill="none" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                        </button>
                        <button class="action-btn edit btn-edit-node" data-id="${n.id}" title="Editar Nodo">
                            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" fill="none" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 1 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                        </button>
                        ${['MUFLA', 'ODF', 'CAJA_NAP'].includes(n.node_type) ? `
                        <a class="action-btn splices" href="/empalmes?node_id=${n.id}" title="Ver Diagrama de Empalmes" style="color: white; display: flex; align-items: center; justify-content: center; text-decoration: none;">
                            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" fill="none" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><path d="M10 6.5h4v7"></path></svg>
                        </a>
                        ` : ''}
                        <button class="action-btn delete" onclick="deleteNode('${n.id}')" title="Eliminar Nodo">
                            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" fill="none" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                        </button>
                    </div>
                </td>
            </tr>
        `).join("");

        // Wire up event listeners dynamically
        document.querySelectorAll(".btn-edit-node").forEach(btn => {
            btn.addEventListener("click", (e) => {
                const id = (e.currentTarget as HTMLButtonElement).getAttribute("data-id")!;
                openModal(id);
            });
        });
    }

    (window as any).deleteNode = async function(id: string) {
        if (!confirm("¿Eliminar este nodo? Todos los cables y empalmes asociados también se verán afectados.")) return;
        try {
            const res = await apiFetch(`${API_BASE}/nodes/${id}`, { method: "DELETE" });
            if (res.ok) {
                loadNodes();
            } else {
                alert("No se pudo eliminar el nodo.");
            }
        } catch {
            alert("Error de conexión al eliminar.");
        }
    };

    // Modal Control
    function openModal(id: string | null = null) {
        nodeForm.reset();
        
        // Default coordinates
        let defaultLat = 4.6097;
        let defaultLng = -74.0817;

        // Try to read from last map view
        const savedView = localStorage.getItem('ftth_last_view');
        if (savedView) {
            try {
                const parsed = JSON.parse(savedView);
                if (parsed.center) {
                    defaultLat = parsed.center[0];
                    defaultLng = parsed.center[1];
                }
            } catch {}
        }

        if (id) {
            modalTitle.textContent = "Editar Nodo";
            const node = cachedNodes.find(n => n.id === id);
            if (node) {
                nodeIdInput.value = node.id;
                nodeNameInput.value = node.name;
                nodeTypeSelect.value = node.node_type;
                nodePowerInput.value = node.optical_power_dbm !== null ? String(node.optical_power_dbm) : "";
                nodeLatInput.value = String(node.location.lat);
                nodeLngInput.value = String(node.location.lng);
                nodeDescInput.value = node.description || "";
            }
        } else {
            modalTitle.textContent = "Nuevo Nodo";
            nodeIdInput.value = "";
            nodeLatInput.value = String(defaultLat);
            nodeLngInput.value = String(defaultLng);
        }
        modal.style.display = "flex";
    }

    function closeModal() {
        modal.style.display = "none";
    }

    nodeForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        
        const id = nodeIdInput.value;
        const payload = {
            name: nodeNameInput.value,
            node_type: nodeTypeSelect.value,
            optical_power_dbm: nodePowerInput.value ? parseFloat(nodePowerInput.value) : null,
            location: {
                lat: parseFloat(nodeLatInput.value),
                lng: parseFloat(nodeLngInput.value)
            },
            description: nodeDescInput.value || null,
            status: "online"
        };

        try {
            let res;
            if (id) {
                res = await apiFetch(`${API_BASE}/nodes/${id}`, {
                    method: "PUT",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(payload)
                });
            } else {
                res = await apiFetch(`${API_BASE}/nodes`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(payload)
                });
            }

            if (res.ok) {
                closeModal();
                loadNodes();
            } else {
                const errData = await res.json();
                alert(`Error: ${errData.detail || "No se pudo guardar el nodo."}`);
            }
        } catch (err) {
            alert("Error de conexión al guardar el nodo.");
        }
    });

    document.getElementById("btn-new-node")!.addEventListener("click", () => openModal(null));
    document.getElementById("btn-close-modal")!.addEventListener("click", closeModal);
    document.getElementById("btn-cancel-modal")!.addEventListener("click", closeModal);

    loadNodes();
</script>
