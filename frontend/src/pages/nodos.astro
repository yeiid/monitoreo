---
import DashboardLayout from "../layouts/DashboardLayout.astro";
---

<DashboardLayout title="Nodos de Red - FTTH Mapper">
    <div class="data-table-container animate-in">
        <div
            style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;"
        >
            <div>
                <h1
                    style="font-size: 1.8rem; font-weight: 800; margin-bottom: 4px;"
                >
                    Gestión de Nodos
                </h1>
                <p style="color: var(--text-muted); font-size: 0.9rem;">
                    Visualiza y administra todos los puntos físicos de tu
                    infraestructura.
                </p>
            </div>
            <div style="display: flex; gap: 12px;">
                <a href="/" class="btn btn-glass" style="text-decoration: none;"
                    >← Volver al Mapa</a
                >
                <button class="btn btn-primary">+ Nuevo Nodo</button>
            </div>
        </div>

        <div class="stats-grid">
            <div class="stat-card glass-panel">
                <div
                    class="stat-icon"
                    style="background: rgba(244, 63, 94, 0.1); color: var(--olt-color);"
                >
                    📡
                </div>
                <div class="stat-info">
                    <span class="label">Total OLTs</span>
                    <span class="value" id="count-olt">-</span>
                </div>
            </div>
            <div class="stat-card glass-panel">
                <div
                    class="stat-icon"
                    style="background: rgba(251, 191, 36, 0.1); color: var(--mufla-color);"
                >
                    🔶
                </div>
                <div class="stat-info">
                    <span class="label">Muflas</span>
                    <span class="value" id="count-mufla">-</span>
                </div>
            </div>
            <div class="stat-card glass-panel">
                <div
                    class="stat-icon"
                    style="background: rgba(34, 211, 238, 0.1); color: var(--nap-color);"
                >
                    📦
                </div>
                <div class="stat-info">
                    <span class="label">Cajas NAP</span>
                    <span class="value" id="count-nap">-</span>
                </div>
            </div>
            <div class="stat-card glass-panel">
                <div
                    class="stat-icon"
                    style="background: rgba(52, 211, 153, 0.1); color: var(--client-color);"
                >
                    🏠
                </div>
                <div class="stat-info">
                    <span class="label">Clientes ONU</span>
                    <span class="value" id="count-client">-</span>
                </div>
            </div>
        </div>

        <div class="glass-panel" style="padding: 4px;">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Tipo</th>
                        <th>Ubicación</th>
                        <th>Potencia (dBm)</th>
                        <th>Descripción</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody id="nodes-tbody">
                    <tr>
                        <td
                            colspan="6"
                            style="text-align:center; padding: 60px; color: var(--text-muted);"
                        >
                            <div class="animate-pulse">
                                Cargando nodos de red...
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</DashboardLayout>

<script>
    import { API_BASE } from "../components/map/types";
    const NODE_BADGES: Record<string, string> = {
        OLT: "olt",
        MUFLA: "mufla",
        CAJA_NAP: "nap",
        CLIENTE_ONU: "client",
    };
    const NODE_LABELS: Record<string, string> = {
        OLT: "OLT",
        MUFLA: "Mufla",
        CAJA_NAP: "Caja NAP",
        CLIENTE_ONU: "Cliente ONU",
    };

    async function loadNodes() {
        try {
            const res = await fetch(`${API_BASE}/nodes`);
            if (!res.ok) throw new Error("API error");
            const nodes = await res.json();
            localStorage.setItem("ftth_nodes", JSON.stringify(nodes));
            renderNodes(nodes);
        } catch (e) {
            const cached = localStorage.getItem("ftth_nodes");
            if (cached) renderNodes(JSON.parse(cached));
        }
    }

    (window as any).centerOnNode = function(id: string) {
        const nodes = JSON.parse(localStorage.getItem('ftth_nodes') || '[]');
        const n = nodes.find((node: any) => node.id === id);
        if (n) {
            localStorage.setItem('ftth_center_on_node', JSON.stringify({
                id: n.id,
                lng: n.location.lng,
                lat: n.location.lat
            }));
            window.location.href = '/';
        }
    };

    function renderNodes(nodes: any[]) {
        const counts = { OLT: 0, MUFLA: 0, CAJA_NAP: 0, CLIENTE_ONU: 0 };
        nodes.forEach(n => counts[n.node_type as keyof typeof counts]++);
        
        document.getElementById("count-olt")!.textContent = String(counts.OLT);
        document.getElementById("count-mufla")!.textContent = String(counts.MUFLA);
        document.getElementById("count-nap")!.textContent = String(counts.CAJA_NAP);
        document.getElementById("count-client")!.textContent = String(counts.CLIENTE_ONU);

        const tbody = document.getElementById("nodes-tbody")!;
        if (nodes.length === 0) {
            tbody.innerHTML = '<tr><td colspan="6" class="empty-state">No hay nodos registrados</td></tr>';
            return;
        }

        const nodeIcons: Record<string, string> = {
            OLT: '📡', MUFLA: '🔶', CAJA_NAP: '📦', CLIENTE_ONU: '🏠'
        };

        tbody.innerHTML = nodes.map(n => `
            <tr class="animate-in glass-row">
                <td>
                    <div class="name-cell">
                        <span class="type-icon">${nodeIcons[n.node_type] || '📍'}</span>
                        <div class="name-info">
                            <span class="node-name">${n.name}</span>
                            <span class="node-id">#${n.id.slice(0, 8)}</span>
                        </div>
                    </div>
                </td>
                <td><span class="modern-badge badge-${n.node_type.toLowerCase()}">${NODE_LABELS[n.node_type] || n.node_type}</span></td>
                <td class="coords-cell">${parseFloat(n.location.lat).toFixed(5)}, ${parseFloat(n.location.lng).toFixed(5)}</td>
                <td><span class="power-val ${n.optical_power_dbm < -25 ? 'low' : 'good'}">${n.optical_power_dbm ?? '—'} <small>dBm</small></span></td>
                <td class="desc-cell">${n.description || '—'}</td>
                <td>
                    <div class="action-group">
                        <button class="action-btn locate" onclick="centerOnNode('${n.id}')">
                            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" fill="none" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                        </button>
                        <button class="action-btn delete" onclick="deleteNode('${n.id}')">
                            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" fill="none" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                        </button>
                    </div>
                </td>
            </tr>
        `).join("");
    }

    (window as any).deleteNode = async function(id: string) {
        if (!confirm("¿Eliminar este nodo?")) return;
        try {
            const res = await fetch(`${API_BASE}/nodes/${id}`, { method: "DELETE" });
            if (res.ok) loadNodes();
        } catch {}
    };

    loadNodes();
</script>

<style is:global>
    :root {
        --glass-bg: rgba(255, 255, 255, 0.03);
        --glass-border: rgba(255, 255, 255, 0.08);
        --glass-hover: rgba(255, 255, 255, 0.06);
    }

    .data-table-container {
        padding: 20px;
        max-width: 1400px;
        margin: 0 auto;
    }

    .glass-panel {
        background: var(--glass-bg);
        border: 1px solid var(--glass-border);
        border-radius: 20px;
        backdrop-filter: blur(12px);
        margin-bottom: 24px;
        transition: all 0.3s ease;
    }

    .glass-panel:hover {
        border-color: rgba(255, 255, 255, 0.15);
        box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }

    /* Stats Grid */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        padding: 24px;
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .stat-icon {
        width: 54px;
        height: 54px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        box-shadow: inset 0 0 20px rgba(255,255,255,0.05);
    }

    .stat-info {
        display: flex;
        flex-direction: column;
    }

    .stat-info .label {
        font-size: 0.75rem;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: 600;
    }

    .stat-info .value {
        font-size: 1.8rem;
        font-weight: 800;
        color: white;
        line-height: 1.2;
    }

    /* Modern Table */
    .data-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 8px;
        margin-top: -8px;
    }

    .data-table th {
        padding: 16px 24px;
        text-align: left;
        color: var(--text-muted);
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-weight: 700;
        border: none;
    }

    .glass-row {
        background: rgba(255, 255, 255, 0.02);
        transition: all 0.2s ease;
    }

    .glass-row:hover {
        background: var(--glass-hover);
        transform: scale(1.002);
    }

    .glass-row td {
        padding: 16px 24px;
        border-top: 1px solid var(--glass-border);
        border-bottom: 1px solid var(--glass-border);
    }

    .glass-row td:first-child {
        border-left: 1px solid var(--glass-border);
        border-radius: 12px 0 0 12px;
    }

    .glass-row td:last-child {
        border-right: 1px solid var(--glass-border);
        border-radius: 0 12px 12px 0;
    }

    /* Cell Content */
    .name-cell {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .type-icon {
        font-size: 1.2rem;
        filter: drop-shadow(0 0 8px rgba(255,255,255,0.1));
    }

    .name-info {
        display: flex;
        flex-direction: column;
    }

    .node-name {
        color: white;
        font-weight: 600;
        font-size: 0.95rem;
    }

    .node-id {
        font-size: 0.7rem;
        color: var(--text-muted);
        font-family: monospace;
    }

    /* Badges */
    .modern-badge {
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .badge-olt { background: rgba(244, 63, 94, 0.1); color: #fb7185; }
    .badge-mufla { background: rgba(251, 191, 36, 0.1); color: #fbbf24; }
    .badge-nap { background: rgba(34, 211, 238, 0.1); color: #22d3ee; }
    .badge-client { background: rgba(52, 211, 153, 0.1); color: #34d399; }

    .coords-cell {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.8rem;
        color: var(--text-secondary);
    }

    .power-val {
        font-weight: 700;
        font-size: 1rem;
    }

    .power-val.good { color: #34d399; }
    .power-val.mid { color: #fbbf24; }
    .power-val.low { color: #f43f5e; }

    .desc-cell {
        font-size: 0.82rem;
        color: var(--text-muted);
        max-width: 200px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    /* Actions */
    .action-group {
        display: flex;
        gap: 8px;
    }

    .action-btn {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        border: 1px solid var(--glass-border);
        background: rgba(255,255,255,0.03);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .action-btn:hover {
        background: rgba(255,255,255,0.08);
        transform: translateY(-2px);
    }

    .action-btn.locate:hover { color: var(--nap-color); border-color: var(--nap-color); }
    .action-btn.delete:hover { color: #f43f5e; border-color: #f43f5e; }

    .empty-state {
        text-align: center;
        padding: 80px 0;
        color: var(--text-muted);
        font-style: italic;
    }

    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .animate-in {
        animation: fadeIn 0.4s ease forwards;
    }
</style>
